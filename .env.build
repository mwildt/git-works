# Build configuration for git-works containers
# Copy this file to .env to override defaults

# Container registry
REGISTRY=ghcr.io/mwildt

# Image names
IMAGE_NAME=git-works
VSCODE_IMAGE_NAME=git-works-vscode
OPENCODE_IMAGE_NAME=git-works-opencode

# Default tag
TAG=latest

# Build platforms (comma-separated)
PLATFORMS=linux/amd64,linux/arm64

# Note: VSCode password is configured in podman/vscode/Containerfile
# and should be changed there before deployment
